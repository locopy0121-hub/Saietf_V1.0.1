<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SaiETF" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:statusBarColor">#F2F7FF</item>
        <item name="android:windowBackground">#F2F7FF</item>
        <item name="android:colorAccent">#2563EB</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.SaiETF.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">#0F1B2C</item>
        <item name="android:statusBarColor">#08111F</item>
        <item name="android:windowBackground">#08111F</item>
        <item name="android:colorAccent">#4DA6FF</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
